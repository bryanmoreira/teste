{
    "name": "candidatos/relatorio-clientes",
    "description": "Relatório de clientes em PHP sem framework",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "node tests/frontend.test.js"
        ],
        "test:php": "@php tests/run.php",
        "test:frontend": "node tests/frontend.test.js"
    },
    "config": {
        "sort-packages": true
    }
}
